# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Origen de la consola de administracion. CORS lo trata aparte del publico y,
# como la consola manda cookies, tiene que ser explicito: con credenciales un
# comodin no vale.
ADMIN_URL=http://localhost:3000
# Saltos de proxy en los que confiar para obtener la IP real (rate limit).
# 0 = no confiar en ninguno, que es lo correcto sin balanceador delante.
# Detras de un ALB en prod: 1.
TRUST_PROXY=0
# Exigir verificacion en dos pasos (TOTP) para entrar a la consola. Si no se
# define, se exige solo con NODE_ENV=production. En desarrollo, true sirve para
# probar el enrolamiento con una cuenta de prueba.
# ADMIN_MFA_REQUIRED=false

# AWS — no se rellenan a mano: `npm run infra:env-backend` los escribe en
# backend/.env leyendo SSM y Secrets Manager (ver docs/infrastructure-aws.md).
AWS_REGION=
# Rol vapeupar_app (runtime). Requiere el túnel: npm run infra:db-tunnel
DATABASE_URL=
# Usuario maestro: solo migraciones y db:sync-app-role
MIGRATE_DATABASE_URL=
S3_CATALOG_BUCKET=
CDN_DOMAIN=
# Id de la distribucion de CloudFront. La clave de una imagen se deriva de su
# entidad, asi que reemplazarla no cambia la URL: hay que invalidar la cache
# para que se vea la nueva. Sin este valor la subida funciona y la
# invalidacion no.
CDN_DISTRIBUTION_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Revalidacion on-demand del sitio (A7.3). Tras cada escritura de catalogo,
# contenido o stock, el backend avisa a Next con este secreto (el mismo que
# frontend/.env.local; lo genera `npm run infra:env-backend`). Vacio: no se
# avisa y el sitio tarda hasta 60 s en reflejar el cambio.
REVALIDATE_SECRET=
# Opcional; por defecto http://127.0.0.1:3000/internal/revalidate
REVALIDATE_URL=
# Pedidos guardados desde el sitio (ADR-003). Apagado por defecto: POST
# /api/orders responde 404 hasta que el dueno lo apruebe y la politica de
# datos pase la revision legal. Las rutas de consola funcionan igual.
# Se enciende JUNTO con NEXT_PUBLIC_ORDERS_ENABLED=true del frontend (variable
# de build: frontend/.env.local en local, /vapeupar/<env>/web/ en SSM al
# desplegar). Con solo una de las dos, el carrito no registra pedidos.
ORDERS_ENABLED=false
