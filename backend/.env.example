# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# AWS — no se rellenan a mano: `npm run infra:env-backend` los escribe en
# backend/.env leyendo SSM y Secrets Manager (ver docs/infrastructure-aws.md).
AWS_REGION=
# Rol vapeupar_app (runtime). Requiere el túnel: npm run infra:db-tunnel
DATABASE_URL=
# Usuario maestro: solo migraciones y db:sync-app-role
MIGRATE_DATABASE_URL=
S3_CATALOG_BUCKET=
CDN_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
REVALIDATE_SECRET=
