# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Origen de la consola de administracion. CORS lo trata aparte del publico y,
# como la consola manda cookies, tiene que ser explicito: con credenciales un
# comodin no vale.
ADMIN_URL=http://localhost:3000
# Saltos de proxy en los que confiar para obtener la IP real (rate limit).
# 0 = no confiar en ninguno, que es lo correcto sin balanceador delante.
# Detras de un ALB en prod: 1.
TRUST_PROXY=0

# AWS — no se rellenan a mano: `npm run infra:env-backend` los escribe en
# backend/.env leyendo SSM y Secrets Manager (ver docs/infrastructure-aws.md).
AWS_REGION=
# Rol vapeupar_app (runtime). Requiere el túnel: npm run infra:db-tunnel
DATABASE_URL=
# Usuario maestro: solo migraciones y db:sync-app-role
MIGRATE_DATABASE_URL=
S3_CATALOG_BUCKET=
CDN_DOMAIN=
# Id de la distribucion de CloudFront. La clave de una imagen se deriva de su
# entidad, asi que reemplazarla no cambia la URL: hay que invalidar la cache
# para que se vea la nueva. Sin este valor la subida funciona y la
# invalidacion no.
CDN_DISTRIBUTION_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
REVALIDATE_SECRET=
