{
  "name": "vapeupar-backend",
  "version": "0.1.0",
  "description": "Backend API in TypeScript for Vapeupar Landing & Vape Catalog",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run src",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:sync-app-role": "tsx prisma/sync-app-role.ts",
    "db:seed": "prisma db seed",
    "admin:invite": "tsx scripts/admin-invite.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1157.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "aws-jwt-verify": "^5.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "prisma": "7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
