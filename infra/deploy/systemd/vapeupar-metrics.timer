# Cada 5 minutos, en punto de reloj (:00, :05, ...): un dato por cada periodo
# de 5 minutos de las alarmas, sin huecos por deriva. Las alarmas tratan la
# falta de datos como fallo, así que un hueco largo avisa.
# docs/aws-full-deployment-plan.md F6.
[Unit]
Description=Vapeupar: metricas de la instancia cada 5 minutos

[Timer]
OnCalendar=*:0/5
AccuracySec=10s
# Si la instancia estaba apagada a la hora, se lanza al arrancar.
Persistent=true

[Install]
WantedBy=timers.target
