{
  "name": "vapeupar",
  "version": "1.0.0",
  "private": true,
  "description": "Vapeupar - Landing page y catálogo de ventas para tienda de vaporizadores",
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:all": "npx concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "test": "npm run test --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "infra:diff": "npm run diff --workspace=infra",
    "infra:deploy": "npm run deploy --workspace=infra",
    "infra:db-tunnel": "npm run db:tunnel --workspace=infra",
    "infra:env-backend": "npm run env:backend --workspace=infra"
  },
  "keywords": [
    "vape",
    "vaporizadores",
    "nextjs",
    "react",
    "typescript",
    "ecommerce"
  ],
  "author": "Vapeupar Team"
}
