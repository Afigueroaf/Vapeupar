{
  "name": "vapeupar",
  "version": "1.0.0",
  "private": true,
  "description": "Vapeupar - Landing page y catálogo de ventas para tienda de vaporizadores",
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "deathnote": "node scripts/deathnote.mjs",
    "dev": "npm run dev --workspace=frontend",
    "dev:all": "npx concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:infra": "npm run test --workspace=infra",
    "test": "npm run test:backend && npm run test:frontend && npm run test:infra",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "check:bundle": "node scripts/check-bundle.mjs",
    "infra:diff": "npm run diff --workspace=infra",
    "infra:deploy": "npm run deploy --workspace=infra",
    "infra:db-tunnel": "npm run db:tunnel --workspace=infra",
    "infra:env-backend": "npm run env:backend --workspace=infra",
    "app:deploy": "npm run app:deploy --workspace=infra --",
    "app:rollback": "npm run app:rollback --workspace=infra --",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:sync-app-role": "npm run db:sync-app-role --workspace=backend",
    "admin:invite": "npm run admin:invite --workspace=backend --"
  },
  "keywords": [
    "vape",
    "vaporizadores",
    "nextjs",
    "react",
    "typescript",
    "ecommerce"
  ],
  "author": "Vapeupar Team"
}
