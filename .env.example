# Configuración General del Proyecto Vapeupar

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Dominio de CloudFront del entorno, el mismo valor que CDN_DOMAIN en el
# backend. Sin el, next/image rechaza las imagenes del catalogo real.
NEXT_PUBLIC_CDN_DOMAIN=
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
# Telefono en formato E.164. Sin valor, la web omite el enlace de llamada.
NEXT_PUBLIC_STORE_PHONE=+573001234567
NEXT_PUBLIC_STORE_NAME=Vapeupar
NEXT_PUBLIC_STORE_CITY=Valledupar
